# Docker Compose deployment settings — copy to .env and fill in real values.
# Leave ADMIN_EMAIL and ADMIN_PASSWORD blank to create the admin account in the
# browser on first run (the "Create admin account" screen). Set both only if you
# want to seed an admin at startup instead.
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGIN=http://your-domain-or-ip
# Optional: at-rest encryption key for stored secrets (LLM/integration API keys).
# Leave blank and the app auto-generates it and persists it beside the database on
# the db_data volume, so it survives rebuilds. Set it explicitly (32 bytes as hex,
# base64, or a 32-char string — e.g. `openssl rand -hex 32`) to manage the key
# yourself. Keep it safe: losing the key makes existing stored secrets unrecoverable.
TTGO_ENCRYPTION_KEY=
