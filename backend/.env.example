# Local development settings — copy to backend/.env and fill in real values.
DB_PATH=tracker.db
# Optional: seed the first admin at startup. Leave both blank to create the
# admin account in the browser on first run (Create admin account screen).
ADMIN_EMAIL=
ADMIN_PASSWORD=
CORS_ORIGIN=http://localhost:5173
LISTEN_ADDR=:8080
# Optional: at-rest encryption key for stored secrets. Leave blank and the app
# auto-generates it and persists it beside DB_PATH (`secret.key`). Set it (32 bytes
# as hex, base64, or a 32-char string) to manage the key yourself.
TTGO_ENCRYPTION_KEY=
