# Local development settings — copy to backend/.env and fill in real values.
DB_PATH=tracker.db
# Optional: seed the first admin at startup. Leave both unset to create the
# admin account in the browser on first run (Create admin account screen).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-real-password
CORS_ORIGIN=http://localhost:5173
LISTEN_ADDR=:8080
