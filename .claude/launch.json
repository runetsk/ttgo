{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "-tags", "sqlite_fts5", "./cmd/server"],
      "cwd": "backend",
      "port": 8090,
      "env": { "ADMIN_EMAIL": "admin@example.com", "ADMIN_PASSWORD": "changeme123", "LISTEN_ADDR": ":8090" }
    },
    {
      "name": "backend-ai",
      "runtimeExecutable": "go",
      "runtimeArgs": ["run", "-tags", "sqlite_fts5", "./cmd/server"],
      "cwd": "backend",
      "port": 8090,
      "env": {
        "DB_PATH": "../perf/.scratch/perf-ai.db",
        "ADMIN_EMAIL": "admin@example.com",
        "ADMIN_PASSWORD": "changeme123",
        "LISTEN_ADDR": ":8090"
      }
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 5173,
      "autoPort": false,
      "env": { "TTGO_DEV_API_TARGET": "http://localhost:8090" }
    },
    {
      "name": "frontend-preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "preview"],
      "cwd": "frontend",
      "port": 4173,
      "autoPort": false
    }
  ]
}
